[Unit]
Description=ETF original five daily notification slots (Asia/Shanghai)

[Timer]
OnCalendar=*-*-* 09:45:00 Asia/Shanghai
OnCalendar=*-*-* 11:45:00 Asia/Shanghai
OnCalendar=*-*-* 14:45:00 Asia/Shanghai
OnCalendar=*-*-* 14:50:00 Asia/Shanghai
OnCalendar=*-*-* 14:54:00 Asia/Shanghai
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=position-etf-reminder.service

[Install]
WantedBy=timers.target
