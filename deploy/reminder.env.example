# Private production copy: /srv/investment-dashboard/reminder.env (0600).
# Migration phase: keep all sending disabled, timer executes dry-run.
ENABLE_FANGTANG=false
ENABLE_WECHAT=false
REMINDER_DRY_RUN=true
REMINDER_NODE=lightsail
SERVERCHAN_SENDKEY=
# WxPusher (https://wxpusher.zjiecode.com): plain HTTPS, allowed on Lightsail.
# Enable on exactly one production node (delivery ledgers are per node).
ENABLE_WXPUSHER=false
# appToken (AT_...) needs UIDs/topics below; a simple-push token (SPT_...) needs neither.
WXPUSHER_APP_TOKEN=
# Recipients: comma-separated UIDs and/or topic IDs (at least one when enabled).
WXPUSHER_UIDS=
WXPUSHER_TOPIC_IDS=
